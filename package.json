{
  "name": "scribble-ui",
  "version": "0.1.0",
  "description": "Rough.js hand-drawn component library built on Radix primitives. A sketchy, organic aesthetic for React apps.",
  "keywords": [
    "shadcn",
    "roughjs",
    "hand-drawn",
    "sketchy",
    "radix-ui",
    "react",
    "components",
    "ui"
  ],
  "homepage": "https://mitchforest.com/projects/scribble-ui",
  "repository": {
    "type": "git",
    "url": "https://github.com/MitchForest/scribble-ui"
  },
  "author": {
    "name": "Mitch Forest",
    "url": "https://mitchforest.com"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "check": "bun run lint && bun run typecheck && bun run validate",
    "build": "bun run build:registry",
    "prepublishOnly": "bun run check && bun run build",
    "build:registry": "node scripts/build-registry.js",
    "validate": "node scripts/validate-registry.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
